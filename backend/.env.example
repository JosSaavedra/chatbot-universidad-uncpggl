APP_NAME=Laravel
APP_ENV=local
# Activar "demo" únicamente en una instalación aislada de datos ficticios.
STUDENT_ACCESS_MODE=institutional
# En Render Free, activar para sembrar una base SQLite vacía al arrancar.
# Es idempotente: si ya hay datos, no escribe nada ni restablece contraseñas.
DEMO_SEED_ON_EMPTY=false
# Opcional. Objeto JSON privado carné → hash bcrypt para las cuatro cuentas tradicionales.
# Si se define en .env, encierra el JSON en comillas simples para preservar los signos $.
DEMO_STUDENT_PASSWORD_HASHES=
# Los datos ficticios se aprovisionan con `php artisan demo:ensure-seeded`.
# Consulta backend/SEGURIDAD.md.
# Proxies inversos de confianza para obtener la IP real en el limitador de
# acceso. En Render puede ser "*"; en instalaciones directas conviene usar la
# red o los rangos IP reales del proxy.
TRUSTED_PROXIES=
TOKEN_LIFETIME_MINUTES=120
TOKEN_IDLE_MINUTES=30
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en Render y otros despliegues HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# El acceso QR + Google NO envía correos. Se conserva la configuración de correo
# para otras funciones del proyecto; "log" evita envíos accidentales.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq / IA del chatbot
# GROQ_API_KEY se usa para el asistente. Si no está definida, se reutiliza OPENAI_API_KEY.
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_TIMEOUT=4

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1

# Acceso QR + Google OIDC. Todos los valores son PRIVADOS del backend.
# Registra exactamente GOOGLE_REDIRECT_URI en Google Cloud Console.
GOOGLE_CLIENT_ID=
# GOOGLE_SECRET se acepta como alias en Render; usa uno solo de los dos.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_JWKS_CACHE_SECONDS=3600

# Vinculaciones preautorizadas. Sólo marcadores ficticios en este archivo
# público: tres titulares y los seis carnés protegidos. En Render se pega el
# JSON crudo, sin las comillas simples externas que usa este archivo .env.
GOOGLE_ACCOUNT_LINKS='[{"owner":"responsable-uno","email":"uno@example.com","carnets":"2024-MED-5837,2023-ISI-9264"},{"owner":"responsable-dos","email":"dos@example.com","carnets":"2024-ADM-1748,2022-ICI-8392"},{"owner":"responsable-tres","email":"tres@example.com","carnets":"2025-ENF-4621,2023-MED-7056"}]'
QR_AUTH_TTL_MINUTES=10
QR_EMAIL_2024_MED_5837=
QR_EMAIL_2024_ADM_1748=
QR_EMAIL_2025_ENF_4621=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# URL HTTPS pública del backend usada dentro del código QR.
QR_AUTH_URL=http://localhost:8000
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# Sólo pruebas: dejar vacío en producción.
QR_AUTH_TEST_OIDC_VERIFIER=
